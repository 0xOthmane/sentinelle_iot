# Copy to `.env` for local `expo start` (Expo inlines EXPO_PUBLIC_* at bundle time).
# For cloud (EAS) builds, `.env` is NOT uploaded: set the same variables in the
# EAS "preview" environment instead (see DEPLOYMENT.md).
#
# Fallbacks used when a variable is missing are defined in src/constants/config.ts.
# EXPO_PUBLIC_DEVICE_ID / EXPO_PUBLIC_GROUP_NAME must match the MQTT topic
# `sentinelle/<group>/<deviceId>/...` your sensor publishes on.

# Public base URL of the API (no trailing slash). Use the https tunnel URL for
# Android builds: release builds block cleartext http.
EXPO_PUBLIC_API_URL=http://172.20.10.4:3000
# Optional: derived from EXPO_PUBLIC_API_URL (http->ws, https->wss, + /ws) when unset.
EXPO_PUBLIC_WS_URL=ws://172.20.10.4:3000/ws
EXPO_PUBLIC_DEVICE_ID=esp05
EXPO_PUBLIC_GROUP_NAME=groupe5
EXPO_PUBLIC_APP_NAME=Petit Nid
