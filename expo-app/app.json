{
  "expo": {
    "name": "expo-app",
    "slug": "expo-app",
    "scheme": "petit-nid",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "iot.sentinelle.grp05"
    },
    "plugins": [
      "expo-notifications",
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "none-er1"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b375f1f-1c14-4a4b-a071-440504bd55ba"
      }
    }
  }
}
