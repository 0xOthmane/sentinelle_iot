{
  "expo": {
    "name": "expo-app",
    "slug": "expo-app",
    "scheme": "petit-nid",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-notifications",
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      "expo-secure-store"
    ]
  }
}
